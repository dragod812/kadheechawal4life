{
  "name": "kadheechawal4life",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/rsvp/app.js --bundle --minify --format=esm --target=es2022 --outfile=invite/rsvp/app.js --external:./firebase-config.js",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test:rules": "firebase emulators:exec --project demo-wedding-rsvp --only firestore 'node --test tests/firestore.rules.test.js'",
    "test:e2e": "firebase emulators:exec --project demo-wedding-rsvp --only auth,firestore 'playwright test'"
  },
  "dependencies": { "firebase": "13.0.0" },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.0"
  },
  "overrides": { "@grpc/grpc-js": "1.14.6" }
}
